# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Secret payloads (only keep samples in git)
/secrets/*.json
!/secrets/*.sample.json

# Database passwords (security-sensitive)
*-db-password.txt
procureiq-db-password.txt

# Team member data (security-sensitive)
.team-roles.csv
team-roles.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
cloud-sql-proxy.exe

# Build artifacts and temporary files
cloudrun_*.json
.cloud_errors.json
tmp_*.html
*.log
kling_log.txt

# AI Operator & Media
ai_operator/ai_env/
outputs/
memory/
public/videos/
*.wav
.gemini/

# CRITICAL: local tool config containing live API keys (OpenRouter etc.)
config.yaml
config.yml
.cline/

# Large build/source archives (too big for GitHub; keep local only)
*.tgz
*.tar.gz
source.tgz
latest_source.tgz

# Cloud SQL Proxy binaries (downloaded locally, not source)
cloud-sql-proxy
cloud-sql-proxy.*

# Local diagnostic / scratch output
pre_dump.txt
file_list.txt
pg-out.txt
pg-exit.txt
tsc-error.txt
tsc2.txt
tsc*.log
dev_log.txt
.dockerenv

# Archived snapshots from other projects / prior migrations (keep local)
_legacy/
deliverables/